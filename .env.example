# Optional Firebase App Check reCAPTCHA v3 / Enterprise site key
# Configured in Firebase Console -> App Check
VITE_RECAPTCHA_SITE_KEY=""

# GEMINI_API_KEY: Optional server-side API key if server features are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
